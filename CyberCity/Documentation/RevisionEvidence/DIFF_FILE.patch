diff --git a/Assets/CyberCity/Resources/npc_dialogue.json b/Assets/CyberCity/Resources/npc_dialogue.json
new file mode 100644
index 0000000..2bcc51b
--- /dev/null
+++ b/Assets/CyberCity/Resources/npc_dialogue.json
@@ -0,0 +1,11 @@
+{
+  "mentors": [
+    {"npc":"Professor Byte","greetingId":"Selamat datang di ruang belajarku, {player}. Kota yang aman dimulai dari warga yang mau bertanya.","greetingEn":"Welcome to my study, {player}. A safer city begins with people who ask questions.","replyId":"Aku siap belajar, Profesor. Dari mana aku harus mulai?","replyEn":"I'm ready to learn, Professor. Where should I begin?","lessonId":"Jangan buru-buru percaya. Periksa sumber, jaga data pribadi, dan bantu tetanggamu melakukan hal yang sama.","lessonEn":"Don't rush to trust. Check the source, protect personal data, and help your neighbours do the same."},
+    {"npc":"Alex","greetingId":"Hei, {player}! Ini sudut kerjaku di Internet Cafe. Pesan promosi masuk terus sejak pagi.","greetingEn":"Hey, {player}! This is my studio at the Internet Cafe. Promotional messages have been pouring in all morning.","replyId":"Aku akan membantumu memilahnya. Ada pesan yang membuatmu curiga?","replyEn":"I'll help you sort them out. Does any message look suspicious?","lessonId":"Ada yang mendesak aku menyerahkan kode login. Ayo periksa petunjuknya, bukan cuma logonya.","lessonEn":"One demands my login code right away. Let's examine the clues, not just its logo."},
+    {"npc":"Maya","greetingId":"Masuk, {player}. Di ruangan ini aku membandingkan pesan dengan sumber aslinya.","greetingEn":"Come in, {player}. In this room I compare messages against their original sources.","replyId":"Aku membawa rasa penasaran. Detail mana yang paling sering terlewat?","replyEn":"I brought my curiosity. Which details do people most often miss?","lessonId":"Alamat pengirim, tujuan tautan, dan tekanan waktu. Kita teliti satu per satu sebelum mengambil keputusan.","lessonEn":"The sender's address, the link destination, and time pressure. We inspect them one by one before deciding."},
+    {"npc":"Detective Byte","greetingId":"Kantorku penuh petunjuk, {player}. Tapi petunjuk belum tentu menjadi bukti.","greetingEn":"My office is full of clues, {player}. But a clue is not automatically evidence.","replyId":"Aku ingin membantu penyelidikan. Kita mulai dari mana?","replyEn":"I'd like to help with the investigation. Where do we start?","lessonId":"Susun kronologi, catat temuan, lalu uji dugaanmu. Jangan ubah bukti asli saat menyelidiki.","lessonEn":"Build a timeline, record your findings, then test your theory. Keep original evidence intact."},
+    {"npc":"SysAdmin Tux","greetingId":"Selamat datang di ruang server, {player}. Dengung mesin ini berarti masih ada yang harus kita rawat.","greetingEn":"Welcome to the server room, {player}. That hum means there's always something to maintain.","replyId":"Aku siap membuka terminal. Tenang, aku akan membaca dulu sebelum menjalankan sesuatu.","replyEn":"I'm ready for the terminal. Don't worry, I'll read before running anything.","lessonId":"Bagus. Jelajahi direktori, pahami izin file, dan berikan akses secukupnya. Kerapian kecil mencegah masalah besar.","lessonEn":"Good. Explore directories, understand file permissions, and grant only the access needed. Small habits prevent big problems."},
+    {"npc":"Red","greetingId":"Selamat datang di web lab-ku, {player}. Hari ini kita mencari celah, lalu memperbaiki penyebabnya.","greetingEn":"Welcome to my web lab, {player}. Today we find weaknesses, then fix their causes.","replyId":"Aku siap menguji dan memeriksa ulang perbaikannya. Konsol di sebelah sana untuk apa?","replyEn":"I'm ready to test and verify the fixes. What's that console over there for?","lessonId":"Itu Virus Sweep, latihan refleks opsional. Kamu bisa mengambil tugas utama atau membantuku membersihkan tiga gelombang virus simulasi.","lessonEn":"That's Virus Sweep, an optional reflex exercise. Take your main assignment or help me clear three waves of simulated viruses."},
+    {"npc":"Blue","greetingId":"Selamat datang di ruang SOC, {player}. Banyak alarm berbunyi, tetapi tidak semuanya ancaman.","greetingEn":"Welcome to the SOC, {player}. There are plenty of alerts, but not every alert is a threat.","replyId":"Aku akan mencari pola, bukan sekadar menekan tombol tutup.","replyEn":"I'll look for patterns instead of just dismissing alerts.","lessonId":"Tepat. Hubungkan log dengan kejadian, pilih respons yang sesuai, dan tulis laporan yang bisa ditindaklanjuti tim.","lessonEn":"Exactly. Connect logs to events, choose the right response, and write a report the team can act on."}
+  ]
+}
